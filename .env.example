# ==============================================================================
# Voxa — environment template. Copy to `.env` and fill in.
# NEVER commit the filled-in `.env`.
# ==============================================================================

# ---- Database ----------------------------------------------------------------
# Neon: use the *pooled* connection string, and strip any `?sslmode=` /
# `?channel_binding=` query params — asyncpg does not understand them.
# SSL is enabled automatically for non-localhost hosts (see app/db.py).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/voxa

# ---- Azure OpenAI ------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Must match the deployed embedding model's dimensionality. Changing this
# requires a new migration, because the pgvector column is fixed-width.
EMBEDDING_DIMENSIONS=1536

# ---- Clerk -------------------------------------------------------------------
# Enable Configure -> Organizations first, or there is no `org_id` claim and
# every authenticated request is rejected on purpose.
# Backend
CLERK_SECRET_KEY=sk_test_...
# The "Frontend API URL", no trailing slash: app/deps.py appends
# /.well-known/jwks.json to it and also verifies it as the `iss` claim.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Only for a publicly reachable webhook endpoint. Leave EMPTY to disable —
# a fake value fails Svix verification with a misleading 401.
CLERK_WEBHOOK_SECRET=
# Frontend (must be prefixed NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---- Google Calendar OAuth ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# ---- Encryption --------------------------------------------------------------
# Fernet key protecting Google refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Email (Gmail SMTP with an App Password) ---------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=you@gmail.com
SMTP_FROM_NAME=Voxa

# ---- Speech ------------------------------------------------------------------
# tiny.en fits Render's 512MB free tier; base.en is noticeably better locally.
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8
PIPER_VOICE=en_US-lessac-medium
VOICE_MODELS_DIR=./models

# ---- URLs / CORS -------------------------------------------------------------
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---- Web app -----------------------------------------------------------------
# Server-side fetches from Next.js use this; the browser uses NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
